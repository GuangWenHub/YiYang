<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yiyang.medicationRecord.mapper.MedicationRecordMapper">
    
    <resultMap type="MedicationRecord" id="MedicationRecordResult">
        <result property="recordId"    column="record_id"    />
        <result property="orderId"    column="order_id"    />
        <result property="medicineId"    column="medicine_id"    />
        <result property="medicineName"    column="medicine_name"    />
        <result property="scheduledTime"    column="scheduled_time"    />
        <result property="actualTime"    column="actual_time"    />
        <result property="nurseId"    column="nurse_id"    />
        <result property="imageUrl"    column="image_url"    />
        <result property="status"    column="status"    />
        <result property="remark"    column="remark"    />
        <result property="orderContent"    column="order_content"    />
        <result property="medicationAdvice"    column="medication_advice"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="delFlag"    column="del_flag"    />
    </resultMap>

    <sql id="selectMedicationRecordVo">
        select mr.record_id, mr.order_id, mr.medicine_id, m.medicine_name, mr.scheduled_time, mr.actual_time, mr.nurse_id, mr.image_url, mr.status, mr.remark, mo.order_content, mo.medication_advice, mr.create_by, mr.create_time, mr.update_by, mr.update_time, mr.del_flag
        from medication_record mr
        left join medicine m on mr.medicine_id = m.medicine_id
        left join medical_order mo on mr.order_id = mo.order_id
    </sql>

    <select id="selectMedicationRecordList" parameterType="MedicationRecord" resultMap="MedicationRecordResult">
        <include refid="selectMedicationRecordVo"/>
        <where>  
            <if test="scheduledTime != null "> and scheduled_time = #{scheduledTime}</if>
            <if test="actualTime != null "> and actual_time = #{actualTime}</if>
            <if test="nurseId != null "> and nurse_id = #{nurseId}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
    </select>
    
    <select id="selectMedicationRecordByRecordId" parameterType="Long" resultMap="MedicationRecordResult">
        <include refid="selectMedicationRecordVo"/>
        where record_id = #{recordId}
    </select>

    <insert id="insertMedicationRecord" parameterType="MedicationRecord" useGeneratedKeys="true" keyProperty="recordId">
        insert into medication_record
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="orderId != null">order_id,</if>
            <if test="medicineId != null">medicine_id,</if>
            <if test="scheduledTime != null">scheduled_time,</if>
            <if test="actualTime != null">actual_time,</if>
            <if test="nurseId != null">nurse_id,</if>
            <if test="imageUrl != null">image_url,</if>
            <if test="status != null">status,</if>
            <if test="remark != null">remark,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="delFlag != null">del_flag,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="orderId != null">#{orderId},</if>
            <if test="medicineId != null">#{medicineId},</if>
            <if test="scheduledTime != null">#{scheduledTime},</if>
            <if test="actualTime != null">#{actualTime},</if>
            <if test="nurseId != null">#{nurseId},</if>
            <if test="imageUrl != null">#{imageUrl},</if>
            <if test="status != null">#{status},</if>
            <if test="remark != null">#{remark},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="delFlag != null">#{delFlag},</if>
         </trim>
    </insert>

    <update id="updateMedicationRecord" parameterType="MedicationRecord">
        update medication_record
        <trim prefix="SET" suffixOverrides=",">
            <if test="orderId != null">order_id = #{orderId},</if>
            <if test="medicineId != null">medicine_id = #{medicineId},</if>
            <if test="scheduledTime != null">scheduled_time = #{scheduledTime},</if>
            <if test="actualTime != null">actual_time = #{actualTime},</if>
            <if test="nurseId != null">nurse_id = #{nurseId},</if>
            <if test="imageUrl != null">image_url = #{imageUrl},</if>
            <if test="status != null">status = #{status},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="delFlag != null">del_flag = #{delFlag},</if>
        </trim>
        where record_id = #{recordId}
    </update>

    <delete id="deleteMedicationRecordByRecordId" parameterType="Long">
        delete from medication_record where record_id = #{recordId}
    </delete>

    <delete id="deleteMedicationRecordByRecordIds" parameterType="String">
        delete from medication_record where record_id in 
        <foreach item="recordId" collection="array" open="(" separator="," close=")">
            #{recordId}
        </foreach>
    </delete>
    
    <delete id="deleteMedicationRecordByOrderId" parameterType="Long">
        delete from medication_record where order_id = #{orderId}
    </delete>
    
    <select id="selectMedicationRecordByOrderId" parameterType="Long" resultMap="MedicationRecordResult">
        <include refid="selectMedicationRecordVo"/>
        where mr.order_id = #{orderId}
    </select>
</mapper>