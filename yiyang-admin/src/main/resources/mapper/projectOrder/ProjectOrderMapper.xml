<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yiyang.projectOrder.mapper.ProjectOrderMapper">
    
    <resultMap type="ProjectOrder" id="ProjectOrderResult">
        <result property="orderId"    column="order_id"    />
        <result property="elderlyId"    column="elderly_id"    />
        <result property="creatorId"    column="creator_id"    />
        <result property="creatorRole"    column="creator_role"    />
        <result property="auditorId"    column="auditor_id"    />
        <result property="status"    column="status"    />
        <result property="createdTime"    column="created_time"    />
        <result property="submittedTime"    column="submitted_time"    />
        <result property="approvedTime"    column="approved_time"    />
        <result property="remark"    column="remark"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="delFlag"    column="del_flag"    />
    </resultMap>

    <sql id="selectProjectOrderVo">
        select order_id, elderly_id, creator_id, creator_role, auditor_id, status, created_time, submitted_time, approved_time, remark, create_by, create_time, update_by, update_time, del_flag from project_order
    </sql>

    <select id="selectProjectOrderList" parameterType="ProjectOrder" resultMap="ProjectOrderResult">
        <include refid="selectProjectOrderVo"/>
        <where>  
            <if test="elderlyId != null "> and elderly_id = #{elderlyId}</if>
            <if test="creatorId != null "> and creator_id = #{creatorId}</if>
            <if test="status != null "> and status = #{status}</if>
            <if test="createdTime != null "> and created_time = #{createdTime}</if>
        </where>
    </select>
    
    <select id="selectProjectOrderByOrderId" parameterType="Long" resultMap="ProjectOrderResult">
        <include refid="selectProjectOrderVo"/>
        where order_id = #{orderId}
    </select>

    <insert id="insertProjectOrder" parameterType="ProjectOrder" useGeneratedKeys="true" keyProperty="orderId">
        insert into project_order
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="elderlyId != null">elderly_id,</if>
            <if test="creatorId != null">creator_id,</if>
            <if test="creatorRole != null">creator_role,</if>
            <if test="auditorId != null">auditor_id,</if>
            <if test="status != null">status,</if>
            <if test="createdTime != null">created_time,</if>
            <if test="submittedTime != null">submitted_time,</if>
            <if test="approvedTime != null">approved_time,</if>
            <if test="remark != null">remark,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="delFlag != null">del_flag,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="elderlyId != null">#{elderlyId},</if>
            <if test="creatorId != null">#{creatorId},</if>
            <if test="creatorRole != null">#{creatorRole},</if>
            <if test="auditorId != null">#{auditorId},</if>
            <if test="status != null">#{status},</if>
            <if test="createdTime != null">#{createdTime},</if>
            <if test="submittedTime != null">#{submittedTime},</if>
            <if test="approvedTime != null">#{approvedTime},</if>
            <if test="remark != null">#{remark},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="delFlag != null">#{delFlag},</if>
         </trim>
    </insert>

    <update id="updateProjectOrder" parameterType="ProjectOrder">
        update project_order
        <trim prefix="SET" suffixOverrides=",">
            <if test="elderlyId != null">elderly_id = #{elderlyId},</if>
            <if test="creatorId != null">creator_id = #{creatorId},</if>
            <if test="creatorRole != null">creator_role = #{creatorRole},</if>
            <if test="auditorId != null">auditor_id = #{auditorId},</if>
            <if test="status != null">status = #{status},</if>
            <if test="createdTime != null">created_time = #{createdTime},</if>
            <if test="submittedTime != null">submitted_time = #{submittedTime},</if>
            <if test="approvedTime != null">approved_time = #{approvedTime},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="delFlag != null">del_flag = #{delFlag},</if>
        </trim>
        where order_id = #{orderId}
    </update>

    <delete id="deleteProjectOrderByOrderId" parameterType="Long">
        delete from project_order where order_id = #{orderId}
    </delete>

    <delete id="deleteProjectOrderByOrderIds" parameterType="String">
        delete from project_order where order_id in 
        <foreach item="orderId" collection="array" open="(" separator="," close=")">
            #{orderId}
        </foreach>
    </delete>
</mapper>