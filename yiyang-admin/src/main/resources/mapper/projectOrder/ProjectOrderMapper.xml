<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yiyang.projectOrder.mapper.ProjectOrderMapper">
    
    <resultMap type="ProjectOrder" id="ProjectOrderResult">
        <result property="orderId"    column="order_id"    />
        <result property="elderlyId"    column="elderly_id"    />
        <result property="elderlyName"    column="elderly_name"    />
        <result property="itemId"    column="item_id"    />
        <result property="itemName"    column="item_name"    />
        <result property="creatorId"    column="creator_id"    />
        <result property="creatorRole"    column="creator_role"    />
        <result property="auditorId"    column="auditor_id"    />
        <result property="status"    column="status"    />
        <result property="createdTime"    column="created_time"    />
        <result property="submittedTime"    column="submitted_time"    />
        <result property="approvedTime"    column="approved_time"    />
        <result property="remark"    column="remark"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="delFlag"    column="del_flag"    />
        <!-- 关联项目单明细 -->
        <collection property="orderDetails" ofType="ProjectOrderDetail">
            <result property="detailId"    column="detail_id"    />
            <result property="orderId"    column="order_id"    />
            <result property="creatorId"    column="detail_creator_id"    />
            <result property="startDate"    column="start_date"    />
            <result property="endDate"    column="end_date"    />
            <result property="status"    column="detail_status"    />
            <result property="remark"    column="detail_remark"    />
            <result property="createBy"    column="detail_create_by"    />
            <result property="createTime"    column="detail_create_time"    />
            <result property="updateBy"    column="detail_update_by"    />
            <result property="updateTime"    column="detail_update_time"    />
            <result property="delFlag"    column="detail_del_flag"    />
        </collection>
    </resultMap>

    <sql id="selectProjectOrderVo">
        select po.order_id, po.elderly_id, e.name as elderly_name, po.item_id, si.name as item_name, po.creator_id, po.creator_role, po.auditor_id, po.status, po.created_time, po.submitted_time, po.approved_time, po.remark, po.create_by, po.create_time, po.update_by, po.update_time, po.del_flag,
               pod.detail_id, pod.order_id as detail_order_id, pod.creator_id as detail_creator_id, pod.start_date, pod.end_date, pod.status as detail_status, pod.remark as detail_remark, pod.create_by as detail_create_by, pod.create_time as detail_create_time, pod.update_by as detail_update_by, pod.update_time as detail_update_time, pod.del_flag as detail_del_flag
        from project_order po
        left join elderly e on po.elderly_id = e.elderly_id
        left join service_item si on po.item_id = si.item_id
        left join project_order_detail pod on po.order_id = pod.order_id
    </sql>

    <select id="selectProjectOrderList" parameterType="ProjectOrder" resultMap="ProjectOrderResult">
        <include refid="selectProjectOrderVo"/>
        <where>  
            <if test="elderlyId != null "> and elderly_id = #{elderlyId}</if>
            <if test="creatorId != null "> and creator_id = #{creatorId}</if>
            <if test="status != null "> and status = #{status}</if>
            <if test="createdTime != null "> and created_time = #{createdTime}</if>
        </where>
    </select>
    
    <select id="selectProjectOrderByOrderId" parameterType="Long" resultMap="ProjectOrderResult">
        <include refid="selectProjectOrderVo"/>
        where po.order_id = #{orderId}
    </select>

    <insert id="insertProjectOrder" parameterType="ProjectOrder" useGeneratedKeys="true" keyProperty="orderId">
        insert into project_order
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="elderlyId != null">elderly_id,</if>
            <if test="itemId != null">item_id,</if>
            <if test="creatorId != null">creator_id,</if>
            <if test="creatorRole != null">creator_role,</if>
            <if test="auditorId != null">auditor_id,</if>
            <if test="status != null">status,</if>
            <if test="createdTime != null">created_time,</if>
            <if test="submittedTime != null">submitted_time,</if>
            <if test="approvedTime != null">approved_time,</if>
            <if test="remark != null">remark,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="delFlag != null">del_flag,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="elderlyId != null">#{elderlyId},</if>
            <if test="itemId != null">#{itemId},</if>
            <if test="creatorId != null">#{creatorId},</if>
            <if test="creatorRole != null">#{creatorRole},</if>
            <if test="auditorId != null">#{auditorId},</if>
            <if test="status != null">#{status},</if>
            <if test="createdTime != null">#{createdTime},</if>
            <if test="submittedTime != null">#{submittedTime},</if>
            <if test="approvedTime != null">#{approvedTime},</if>
            <if test="remark != null">#{remark},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="delFlag != null">#{delFlag},</if>
         </trim>
    </insert>

    <update id="updateProjectOrder" parameterType="ProjectOrder">
        update project_order
        <trim prefix="SET" suffixOverrides=",">
            <if test="elderlyId != null">elderly_id = #{elderlyId},</if>
            <if test="itemId != null">item_id = #{itemId},</if>
            <if test="creatorId != null">creator_id = #{creatorId},</if>
            <if test="creatorRole != null">creator_role = #{creatorRole},</if>
            <if test="auditorId != null">auditor_id = #{auditorId},</if>
            <if test="status != null">status = #{status},</if>
            <if test="createdTime != null">created_time = #{createdTime},</if>
            <if test="submittedTime != null">submitted_time = #{submittedTime},</if>
            <if test="approvedTime != null">approved_time = #{approvedTime},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="delFlag != null">del_flag = #{delFlag},</if>
        </trim>
        where order_id = #{orderId}
    </update>

    <delete id="deleteProjectOrderByOrderId" parameterType="Long">
        delete from project_order where order_id = #{orderId}
    </delete>

    <delete id="deleteProjectOrderByOrderIds" parameterType="String">
        delete from project_order where order_id in 
        <foreach item="orderId" collection="array" open="(" separator="," close=")">
            #{orderId}
        </foreach>
    </delete>
</mapper>