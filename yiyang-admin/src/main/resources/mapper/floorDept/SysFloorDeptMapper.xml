<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yiyang.floorDept.mapper.SysFloorDeptMapper">

    <resultMap type="SysFloorDept" id="SysFloorDeptResult">
        <id property="floorDeptId" column="floor_dept_id" />
        <result property="floor" column="floor" />
        <result property="deptName" column="dept_name" />
        <result property="deptDesc" column="dept_desc" />
        <result property="status" column="status" />
        <result property="orderNum" column="order_num" />
        <result property="createBy" column="create_by" />
        <result property="createTime" column="create_time" />
        <result property="updateBy" column="update_by" />
        <result property="updateTime" column="update_time" />
        <result property="delFlag" column="del_flag" />
    </resultMap>

    <sql id="selectSysFloorDeptVo">
        select floor_dept_id, floor, dept_name, dept_desc, status, order_num, create_by, create_time, update_by, update_time, del_flag
        from sys_floor_dept
    </sql>

    <select id="selectSysFloorDeptById" parameterType="Long" resultMap="SysFloorDeptResult">
        <include refid="selectSysFloorDeptVo" />
        where floor_dept_id = #{floorDeptId}
    </select>

    <select id="selectSysFloorDeptList" parameterType="SysFloorDept" resultMap="SysFloorDeptResult">
        <include refid="selectSysFloorDeptVo" />
        where del_flag = '0'
        <if test="floor != null">
            and floor = #{floor}
        </if>
        <if test="deptName != null and deptName != ''">
            and dept_name like concat('%', #{deptName}, '%')
        </if>
        <if test="status != null and status != ''">
            and status = #{status}
        </if>
        order by floor, order_num
    </select>

    <insert id="insertSysFloorDept" parameterType="SysFloorDept">
        insert into sys_floor_dept
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="floor != null">floor,</if>
            <if test="deptName != null and deptName != ''">dept_name,</if>
            <if test="deptDesc != null and deptDesc != ''">dept_desc,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="orderNum != null">order_num,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            <if test="createTime != null">create_time,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="floor != null">#{floor},</if>
            <if test="deptName != null and deptName != ''">#{deptName},</if>
            <if test="deptDesc != null and deptDesc != ''">#{deptDesc},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="orderNum != null">#{orderNum},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
        </trim>
    </insert>

    <update id="updateSysFloorDept" parameterType="SysFloorDept">
        update sys_floor_dept
        <set>
            <if test="floor != null">floor = #{floor},</if>
            <if test="deptName != null and deptName != ''">dept_name = #{deptName},</if>
            <if test="deptDesc != null and deptDesc != ''">dept_desc = #{deptDesc},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="orderNum != null">order_num = #{orderNum},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </set>
        where floor_dept_id = #{floorDeptId}
    </update>

    <delete id="deleteSysFloorDeptById" parameterType="Long">
        update sys_floor_dept set del_flag = '2' where floor_dept_id = #{floorDeptId}
    </delete>

    <delete id="deleteSysFloorDeptByIds" parameterType="Long[]">
        update sys_floor_dept set del_flag = '2' where floor_dept_id in
        <foreach item="floorDeptId" collection="array" open="(" separator="," close=")">
            #{floorDeptId}
        </foreach>
    </delete>

</mapper>
