<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yiyang.round.mapper.SysWardRoundMapper">
    
    <resultMap type="SysWardRound" id="SysWardRoundResult">
        <result property="roundId"    column="round_id"    />
        <result property="roomId"    column="room_id"    />
        <result property="bedId"    column="bed_id"    />
        <result property="elderlyId"    column="elderly_id"    />
        <result property="roundTime"    column="round_time"    />
        <result property="roundUserId"    column="round_user_id"    />
        <result property="status"    column="status"    />
        <result property="abnormalDesc"    column="abnormal_desc"    />
        <result property="handleMeasure"    column="handle_measure"    />
        <result property="imageUrl"    column="image_url"    />
        <result property="remark"    column="remark"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="delFlag"    column="del_flag"    />
    </resultMap>

    <sql id="selectSysWardRoundVo">
        select round_id, room_id, bed_id, elderly_id, round_time, round_user_id, status, abnormal_desc, handle_measure, image_url, remark, create_by, create_time, update_by, update_time, del_flag from sys_ward_round
    </sql>

    <select id="selectSysWardRoundList" parameterType="SysWardRound" resultMap="SysWardRoundResult">
        <include refid="selectSysWardRoundVo"/>
        <where>  
            <if test="roomId != null "> and room_id = #{roomId}</if>
            <if test="bedId != null "> and bed_id = #{bedId}</if>
            <if test="elderlyId != null "> and elderly_id = #{elderlyId}</if>
            <if test="roundTime != null "> and round_time = #{roundTime}</if>
            <if test="roundUserId != null "> and round_user_id = #{roundUserId}</if>
            <if test="status != null "> and status = #{status}</if>
        </where>
    </select>
    
    <select id="selectSysWardRoundByRoundId" parameterType="Long" resultMap="SysWardRoundResult">
        <include refid="selectSysWardRoundVo"/>
        where round_id = #{roundId}
    </select>

    <insert id="insertSysWardRound" parameterType="SysWardRound" useGeneratedKeys="true" keyProperty="roundId">
        insert into sys_ward_round
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="roomId != null">room_id,</if>
            <if test="bedId != null">bed_id,</if>
            <if test="elderlyId != null">elderly_id,</if>
            <if test="roundTime != null">round_time,</if>
            <if test="roundUserId != null">round_user_id,</if>
            <if test="status != null">status,</if>
            <if test="abnormalDesc != null">abnormal_desc,</if>
            <if test="handleMeasure != null">handle_measure,</if>
            <if test="imageUrl != null">image_url,</if>
            <if test="remark != null">remark,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="delFlag != null">del_flag,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="roomId != null">#{roomId},</if>
            <if test="bedId != null">#{bedId},</if>
            <if test="elderlyId != null">#{elderlyId},</if>
            <if test="roundTime != null">#{roundTime},</if>
            <if test="roundUserId != null">#{roundUserId},</if>
            <if test="status != null">#{status},</if>
            <if test="abnormalDesc != null">#{abnormalDesc},</if>
            <if test="handleMeasure != null">#{handleMeasure},</if>
            <if test="imageUrl != null">#{imageUrl},</if>
            <if test="remark != null">#{remark},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="delFlag != null">#{delFlag},</if>
         </trim>
    </insert>

    <update id="updateSysWardRound" parameterType="SysWardRound">
        update sys_ward_round
        <trim prefix="SET" suffixOverrides=",">
            <if test="roomId != null">room_id = #{roomId},</if>
            <if test="bedId != null">bed_id = #{bedId},</if>
            <if test="elderlyId != null">elderly_id = #{elderlyId},</if>
            <if test="roundTime != null">round_time = #{roundTime},</if>
            <if test="roundUserId != null">round_user_id = #{roundUserId},</if>
            <if test="status != null">status = #{status},</if>
            <if test="abnormalDesc != null">abnormal_desc = #{abnormalDesc},</if>
            <if test="handleMeasure != null">handle_measure = #{handleMeasure},</if>
            <if test="imageUrl != null">image_url = #{imageUrl},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="delFlag != null">del_flag = #{delFlag},</if>
        </trim>
        where round_id = #{roundId}
    </update>

    <delete id="deleteSysWardRoundByRoundId" parameterType="Long">
        delete from sys_ward_round where round_id = #{roundId}
    </delete>

    <delete id="deleteSysWardRoundByRoundIds" parameterType="String">
        delete from sys_ward_round where round_id in 
        <foreach item="roundId" collection="array" open="(" separator="," close=")">
            #{roundId}
        </foreach>
    </delete>
</mapper>