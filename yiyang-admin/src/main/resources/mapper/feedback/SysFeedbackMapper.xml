<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yiyang.feedback.mapper.SysFeedbackMapper">

    <resultMap type="SysFeedback" id="SysFeedbackResult">
        <id property="feedbackId" column="feedback_id" />
        <result property="senderId" column="sender_id" />
        <result property="senderName" column="sender_name" />
        <result property="senderRole" column="sender_role" />
        <result property="receiverId" column="receiver_id" />
        <result property="receiverName" column="receiver_name" />
        <result property="receiverRole" column="receiver_role" />
        <result property="type" column="type" />
        <result property="content" column="content" />
        <result property="status" column="status" />
        <result property="parentId" column="parent_id" />
        <result property="createBy" column="create_by" />
        <result property="createTime" column="create_time" />
        <result property="updateBy" column="update_by" />
        <result property="updateTime" column="update_time" />
    </resultMap>

    <sql id="selectSysFeedbackVo">
        select feedback_id, sender_id, sender_name, sender_role, receiver_id, receiver_name, receiver_role, type, content, status, parent_id, create_by, create_time, update_by, update_time
        from sys_feedback
    </sql>

    <select id="selectSysFeedbackById" parameterType="Long" resultMap="SysFeedbackResult">
        <include refid="selectSysFeedbackVo" />
        where feedback_id = #{feedbackId}
    </select>

    <select id="selectSysFeedbackList" parameterType="SysFeedback" resultMap="SysFeedbackResult">
        <include refid="selectSysFeedbackVo" />
        <where>
            <if test="senderId != null">
                and sender_id = #{senderId}
            </if>
            <if test="senderName != null and senderName != ''">
                and sender_name like concat('%', #{senderName}, '%')
            </if>
            <if test="senderRole != null and senderRole != ''">
                and sender_role like concat('%', #{senderRole}, '%')
            </if>
            <if test="receiverId != null">
                and receiver_id = #{receiverId}
            </if>
            <if test="receiverName != null and receiverName != ''">
                and receiver_name like concat('%', #{receiverName}, '%')
            </if>
            <if test="receiverRole != null and receiverRole != ''">
                and receiver_role like concat('%', #{receiverRole}, '%')
            </if>
            <if test="type != null and type != ''">
                and type = #{type}
            </if>
            <if test="status != null and status != ''">
                and status = #{status}
            </if>
        </where>
        order by create_time desc
    </select>

    <select id="selectSysFeedbackByReceiverId" parameterType="Long" resultMap="SysFeedbackResult">
        <include refid="selectSysFeedbackVo" />
        where (receiver_id = #{userId} or receiver_id is null)
        order by create_time desc
    </select>

    <select id="selectSysFeedbackBySenderId" parameterType="Long" resultMap="SysFeedbackResult">
        <include refid="selectSysFeedbackVo" />
        where sender_id = #{userId}
        order by create_time desc
    </select>

    <insert id="insertSysFeedback" parameterType="SysFeedback">
        insert into sys_feedback
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="senderId != null">sender_id,</if>
            <if test="senderName != null and senderName != ''">sender_name,</if>
            <if test="senderRole != null and senderRole != ''">sender_role,</if>
            <if test="receiverId != null">receiver_id,</if>
            <if test="receiverName != null and receiverName != ''">receiver_name,</if>
            <if test="receiverRole != null and receiverRole != ''">receiver_role,</if>
            <if test="type != null and type != ''">type,</if>
            <if test="content != null and content != ''">content,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="parentId != null">parent_id,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            <if test="createTime != null">create_time,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="senderId != null">#{senderId},</if>
            <if test="senderName != null and senderName != ''">#{senderName},</if>
            <if test="senderRole != null and senderRole != ''">#{senderRole},</if>
            <if test="receiverId != null">#{receiverId},</if>
            <if test="receiverName != null and receiverName != ''">#{receiverName},</if>
            <if test="receiverRole != null and receiverRole != ''">#{receiverRole},</if>
            <if test="type != null and type != ''">#{type},</if>
            <if test="content != null and content != ''">#{content},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="parentId != null">#{parentId},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
        </trim>
    </insert>

    <update id="updateSysFeedback" parameterType="SysFeedback">
        update sys_feedback
        <set>
            <if test="senderId != null">sender_id = #{senderId},</if>
            <if test="senderName != null and senderName != ''">sender_name = #{senderName},</if>
            <if test="senderRole != null and senderRole != ''">sender_role = #{senderRole},</if>
            <if test="receiverId != null">receiver_id = #{receiverId},</if>
            <if test="receiverName != null and receiverName != ''">receiver_name = #{receiverName},</if>
            <if test="receiverRole != null and receiverRole != ''">receiver_role = #{receiverRole},</if>
            <if test="type != null and type != ''">type = #{type},</if>
            <if test="content != null and content != ''">content = #{content},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="parentId != null">parent_id = #{parentId},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </set>
        where feedback_id = #{feedbackId}
    </update>

    <update id="updateSysFeedbackStatus">
        update sys_feedback set status = #{arg1} where feedback_id = #{arg0}
    </update>

    <delete id="deleteSysFeedbackById" parameterType="Long">
        delete from sys_feedback where feedback_id = #{feedbackId}
    </delete>

    <delete id="deleteSysFeedbackByIds" parameterType="Long[]">
        delete from sys_feedback where feedback_id in
        <foreach item="feedbackId" collection="array" open="(" separator="," close=")">
            #{feedbackId}
        </foreach>
    </delete>

    <select id="selectSysFeedbackReplies" parameterType="Long" resultMap="SysFeedbackResult">
        <include refid="selectSysFeedbackVo" />
        where parent_id = #{parentId}
        order by create_time asc
    </select>

    <select id="countSysFeedbackReplies" parameterType="Long" resultType="int">
        select count(*) from sys_feedback where parent_id = #{parentId}
    </select>

</mapper>
