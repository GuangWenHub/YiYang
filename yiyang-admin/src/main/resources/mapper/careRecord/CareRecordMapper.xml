<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yiyang.careRecord.mapper.CareRecordMapper">
    
    <resultMap type="CareRecord" id="CareRecordResult">
        <result property="recordId"    column="record_id"    />
        <result property="elderlyId"    column="elderly_id"    />
        <result property="creatorId"    column="creator_id"    />
        <result property="careType"    column="care_type"    />
        <result property="careContent"    column="care_content"    />
        <result property="careTime"    column="care_time"    />
        <result property="startTime"    column="start_time"    />
        <result property="approvedTime"    column="approved_time"    />
        <result property="status"    column="status"    />
        <result property="imageUrl"    column="image_url"    />
        <result property="remark"    column="remark"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="delFlag"    column="del_flag"    />
    </resultMap>

    <sql id="selectCareRecordVo">
        select record_id, elderly_id, creator_id, care_type, care_content, care_time, start_time, approved_time, status, image_url, remark, create_by, create_time, update_by, update_time, del_flag from care_record
    </sql>

    <select id="selectCareRecordList" parameterType="CareRecord" resultMap="CareRecordResult">
        <include refid="selectCareRecordVo"/>
        <where>  
            <if test="elderlyId != null "> and elderly_id = #{elderlyId}</if>
            <if test="creatorId != null "> and creator_id = #{creatorId}</if>
            <if test="careType != null  and careType != ''"> and care_type = #{careType}</if>
            <if test="careTime != null "> and care_time = #{careTime}</if>
            <if test="startTime != null "> and start_time = #{startTime}</if>
            <if test="approvedTime != null "> and approved_time = #{approvedTime}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
    </select>
    
    <select id="selectCareRecordByRecordId" parameterType="Long" resultMap="CareRecordResult">
        <include refid="selectCareRecordVo"/>
        where record_id = #{recordId}
    </select>

    <insert id="insertCareRecord" parameterType="CareRecord" useGeneratedKeys="true" keyProperty="recordId">
        insert into care_record
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="elderlyId != null">elderly_id,</if>
            <if test="creatorId != null">creator_id,</if>
            <if test="careType != null and careType != ''">care_type,</if>
            <if test="careContent != null and careContent != ''">care_content,</if>
            <if test="careTime != null">care_time,</if>
            <if test="startTime != null">start_time,</if>
            <if test="approvedTime != null">approved_time,</if>
            <if test="status != null">status,</if>
            <if test="imageUrl != null">image_url,</if>
            <if test="remark != null">remark,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="delFlag != null">del_flag,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="elderlyId != null">#{elderlyId},</if>
            <if test="creatorId != null">#{creatorId},</if>
            <if test="careType != null and careType != ''">#{careType},</if>
            <if test="careContent != null and careContent != ''">#{careContent},</if>
            <if test="careTime != null">#{careTime},</if>
            <if test="startTime != null">#{startTime},</if>
            <if test="approvedTime != null">#{approvedTime},</if>
            <if test="status != null">#{status},</if>
            <if test="imageUrl != null">#{imageUrl},</if>
            <if test="remark != null">#{remark},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="delFlag != null">#{delFlag},</if>
         </trim>
    </insert>

    <update id="updateCareRecord" parameterType="CareRecord">
        update care_record
        <trim prefix="SET" suffixOverrides=",">
            <if test="elderlyId != null">elderly_id = #{elderlyId},</if>
            <if test="creatorId != null">creator_id = #{creatorId},</if>
            <if test="careType != null and careType != ''">care_type = #{careType},</if>
            <if test="careContent != null and careContent != ''">care_content = #{careContent},</if>
            <if test="careTime != null">care_time = #{careTime},</if>
            <if test="startTime != null">start_time = #{startTime},</if>
            <if test="approvedTime != null">approved_time = #{approvedTime},</if>
            <if test="status != null">status = #{status},</if>
            <if test="imageUrl != null">image_url = #{imageUrl},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="delFlag != null">del_flag = #{delFlag},</if>
        </trim>
        where record_id = #{recordId}
    </update>

    <delete id="deleteCareRecordByRecordId" parameterType="Long">
        delete from care_record where record_id = #{recordId}
    </delete>

    <delete id="deleteCareRecordByRecordIds" parameterType="String">
        delete from care_record where record_id in 
        <foreach item="recordId" collection="array" open="(" separator="," close=")">
            #{recordId}
        </foreach>
    </delete>
</mapper>